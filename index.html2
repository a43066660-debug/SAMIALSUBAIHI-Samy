<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تطبيق فحص الصور</title>
    <!-- استدعاء المكتبة من الإنترنت مباشرة -->
    <script src="https://unpkg.com"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f5f5f5;
        }
        .upload-btn {
            font-size: 18px;
            padding: 12px 24px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <!-- زر اختيار الصورة من الاستوديو يظهر داخل الـ WebViewer -->
    <input type="file" id="qr-input-file" accept="image/*" class="upload-btn">
    
    <!-- حاوية مخفية مطلوبة لتهيئة المكتبة بشكل صحيح -->
    <div id="reader" style="display: none;"></div>

    <script>
        const fileInput = document.getElementById('qr-input-file');

        fileInput.addEventListener('change', e => {
            if (e.target.files.length == 0) return;
            
            const imageFile = e.target.files[0];
            
            // تهيئة كائن الفحص بربطه بالحاوية المخفية
            const html5QrCode = new Html5Qrcode("reader");
            
            // بدء فحص ملف الصورة المحددة
            html5QrCode.scanFile(imageFile, true)
            .then(decodedText => {
                // إرسال النص المستخرج بنجاح إلى تطبيق Kodular
                window.AppInventor.setWebViewString(decodedText);
            })
            .catch(err => {
                // إرسال نص الخطأ في حال كانت الصورة غير واضحة أو لا تحتوي كود
                window.AppInventor.setWebViewString("error_not_found");
            });
        });
    </script>
</body>
</html>
