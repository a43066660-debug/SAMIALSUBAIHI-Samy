<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>توليد رمز QR الخاص بك</title>
    <!-- تضمين مكتبة توليد الرمز من مصدر خارجي آمن -->
    <script src="https://cloudflare.com"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            background-color: #f4f4f9;
            margin: 0;
        }
        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        #qrcode {
            margin: 20px 0;
            display: flex;
            justify-content: center;
        }
        h2 {
            color: #333;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>رمز الاستجابة السريعة (QR Code)</h2>
    <!-- هنا سيتم عرض الرمز -->
    <div id="qrcode"></div>
</div>

<script>
    // البيانات المشفرة المستخرجة من صورتك
    const qrData = '100$ISS:2${"sno":"11088105281a25ef72be","typ":1,"hid":"1088105281","iat":"280225","exp":"300325","cnt":{"pid":"1088105281"}}';

    // توليد الرمز داخل عنصر الـ div المحدد
    new QRCode(document.getElementById("qrcode"), {
        text: qrData,
        width: 256,
        height: 256,
        colorDark : "#000000",
        colorLight : "#ffffff",
        correctLevel : QRCode.CorrectLevel.H
    });
</script>

</body>
</html>
