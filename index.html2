<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
<title>رقم هاتف فيسبوك مع رمز التحقق لمرة واحدة</title>
<style>
	.حاوية {
		أقصى عرض: 300 بكسل؛
		margin: auto;
		padding-top:40px;
		text-align:center;
	}
	رقم، رمز التحقق {
		العرض: 100%؛
		الحشو: 10 بكسل؛
		حجم الخط: 20 بكسل؛
		margin-bottom: 5px;
		المخطط: لا يوجد؛
	}
	#recaptcha-container {
		margin-bottom: 5px;
	}
	إرسال، تحقق {
		العرض: 100%؛
		الارتفاع: 40 بكسل؛
		المخطط: لا يوجد؛
		display:none;
	}
	#يعرض {
		العرض: 100%؛
		الارتفاع: 40 بكسل؛
		المخطط: لا يوجد؛
	}
	.p-conf, .n-conf {
		العرض: 100%؛
		border: 2px solid green;
		border-radius: 4px;
		الحشو: 8 بكسل 10 بكسل؛
		الهامش: 4 بكسل 0 بكسل؛
		لون الخلفية: rgba(0, 249, 12, 0.5)؛
		العرض: لا شيء؛
	}
	.n-conf {
		لون الحدود: أحمر؛
		لون الخلفية: rgba(255, 0, 4, 0.5)؛
	}
</style>
</head>

<body>
	<div class="container">
		<div id="info"></div>
		<div id="sender">
			<input type="text" id="number" placeholder="مثال: +446505551234">
			<input class="w3-btn w3-blue w3-round" type="button" id="show" value="Enter" onClick="render()">
		<br><br>			
		<div id="recaptcha-container"></div>
		<br>
			<input class="w3-btn w3-blue w3-round" type="button" id="send" value="إرسال" onClick="phoneAuth()">
		</div>
		<div id="verifier" style="text-align:center">
			<br>
			<input type="text" id="verificationcode" placeholder="رمز التحقق لمرة واحدة" style="display: none">
			<br>
			<input class="w3-btn w3-blue w3-round" type="button" id="verify" value="Verify" onClick="codeVerify()" style="display: none">
			<br>
			<div class="p-conf">تم التحقق من الرقم</div>
			<div class="n-conf">خطأ في رمز التحقق لمرة واحدة</div>
		</div>
		<div id="messages"></div>
	</div>

<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>

<script>
//أضف إعدادات Firebase الخاصة بك هنا
      const firebaseConfig = {
		apiKey: "",
		authDomain: "",
		databaseURL: "",
		projectId: "",
		حاوية التخزين: "",
		messagingSenderId: "",
		معرف التطبيق: "",
		معرّف القياس: ""
	};

      firebase.initializeApp(firebaseConfig);

      document.getElementById("info").innerHTML = "أدخل رقم هاتفك مع علامة + ورمز البلد، ثم اضغط على Enter";


دالة العرض() {
	document.getElementById("messages").innerHTML = "تم إدخال رقم الهاتف";
	document.getElementById("info").innerHTML = "أكمل اختبار التحقق (علامة صح خضراء)، ثم اضغط على إرسال";
    	window.recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container',{
	  'callback': (response) => {
		إذا كانت الاستجابة لا تساوي ""){
            		document.getElementById("messages").innerHTML = "تم إكمال اختبار التحقق من إعادة التحقق";
			document.getElementById("send").style.display = "block";
		}
          }
      });
    recaptchaVerifier.render();
}

دالة phoneAuth() {
    document.getElementById("verificationcode").style.display = "block";
    document.getElementById("verify").style.display = "block";
    document.getElementById("recaptcha-container").style.display = "none";
    var number = document.getElementById('number').value;
    firebase.auth().signInWithPhoneNumber(number, window.recaptchaVerifier).then(function (confirmationResult) {
        window.confirmationResult = confirmationResult;
        Coderesult = ConfirmResult;
	document.getElementById("messages").innerHTML = "تم إرسال رمز التحقق لمرة واحدة";
	document.getElementById("info").innerHTML = "احصل على رمز التحقق من رسالة SMS الخاصة بك واكتبه/ألصقه، ثم انقر فوق تحقق";
    }).catch(function (error) {
        alert(error.message);
    });
}

دالة التحقق من الكود(){
	var code = document.getElementById('verificationcode').value;
	coderesult.confirm(code).then(function(result){
		const user = result.user;
		document.getElementById("messages").innerHTML = "";
		document.getElementsByClassName('p-conf')[0].style.display = 'block';
		document.getElementsByClassName('n-conf')[0].style.display = 'none';
		إذا كان (window.AppInventor) {            
			window.AppInventor.setWebViewString(JSON.stringify(user));
		}
	}).catch(function(){
		document.getElementsByClassName('p-conf')[0].style.display = 'none';
		document.getElementsByClassName('n-conf')[0].style.display = 'block';
	})
}

</script>
</body>
<!--Credits: https://www.slidesmaker.me/blog/firebase-number-authentication-with-otp-in-javascript-->
</html>
